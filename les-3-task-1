from tkinter import *      # підключаємо бібліотеку tkinter

# -------------------------------------------------
# Пояснення:
# Більшість програм працюють за схемою:
# ВВЕДЕННЯ → ОПРАЦЮВАННЯ → ВИВЕДЕННЯ
#
# У Tkinter:
# Entry  — введення
# Button — дія
# Label  — виведення
# -------------------------------------------------


def show_text():
    # отримуємо текст із поля Entry
    user_text = entry1.get()

    # виводимо цей текст у напис (Label)
    lab.config(text=user_text)


def clear_text():
    # очищаємо поле Entry
    entry1.delete(0, END)

    # очищаємо напис
    lab.config(text="")


root = Tk()                    # створюємо головне вікно
root.title("Введення та виведення")
root.geometry("400x250")

# -------------------- Label --------------------
# Label використовується для виведення тексту

lab = Label(
    root,
    text="Тут з'явиться текст",
    font="Arial 14",
    fg="blue"
)
lab.pack(pady=10)

# -------------------- Entry --------------------
# Entry — однорядкове поле для введення тексту

entry1 = Entry(
    root,
    width=25,
    font="Arial 12"
)
entry1.pack(pady=5)

# -------------------- Button --------------------
# Кнопка запускає функцію

btn1 = Button(
    root,
    text="Показати текст",
    command=show_text
)
btn1.pack(pady=5)

btn2 = Button(
    root,
    text="Очистити",
    command=clear_text
)
btn2.pack(pady=5)


# ---------- ЗАВДАННЯ ДЛЯ УЧНІВ ----------

# 1) Зміни розмір вікна
# 2) Зміни колір тексту напису (fg)
# 3) Додай зміну кольору фону напису (bg)
# 4) Зроби так, щоб якщо поле порожнє,
#    з’являвся текст "Введіть дані!"
#    (використай if)
# 5) Додай ще одну кнопку, яка буде
#    змінювати розмір шрифту напису

root.mainloop()
