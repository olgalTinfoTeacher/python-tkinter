from tkinter import *

# -------------------- ПОЯСНЕННЯ --------------------
# Це велике інтегроване завдання об’єднує:
# 1) Однорядкові поля Entry для введення даних
# 2) Багаторядкове поле Text для опису
# 3) Напис Label для виведення результату
# 4) Кнопки Button для дій
# 5) Прапорці Checkbutton для вибору опцій
# 6) Перемикачі Radiobutton для вибору одного варіанту
# 7) Логіку зміни кольору, шрифту та перевірки введених даних

root = Tk()
root.title("Велике інтегроване завдання Tkinter")
root.geometry("600x500")

# -------------------- ФУНКЦІЇ --------------------

def submit():
    """
    Функція, яка виконується при натисканні кнопки "Надіслати"
    """
    name = entry_name.get()
    age = entry_age.get()
    description = text_desc.get("1.0", "end-1c")  # отримуємо весь текст з Text

    if not name or not age:
        result_label.config(text="Введіть ім'я та вік!", fg="red", bg="white")
        return

    # Перевірка вибраного кольору
    selected_color = color_var.get()
    if selected_color == 1:
        color_text = "червоний"
    elif selected_color == 2:
        color_text = "зелений"
    else:
        color_text = "синій"

    # Перевірка прапорців
    hobbies_list = []
    if cb1_var.get():
        hobbies_list.append("Спорт")
    if cb2_var.get():
        hobbies_list.append("Музика")
    if cb3_var.get():
        hobbies_list.append("Малювання")
    hobbies = ", ".join(hobbies_list) if hobbies_list else "немає"

    # Формуємо результат
    result = f"Ім'я: {name}\nВік: {age}\nЛюбить: {hobbies}\nУлюблений колір: {color_text}\nПро себе: {description}"

    result_label.config(text=result, fg="black", bg="lightyellow")


def clear_all():
    """
    Очищає всі поля та напис
    """
    entry_name.delete(0, END)
    entry_age.delete(0, END)
    text_desc.delete("1.0", END)
    cb1_var.set(0)
    cb2_var.set(0)
    cb3_var.set(0)
    color_var.set(0)
    result_label.config(text="", bg="white")


# -------------------- ВІДЖЕТИ --------------------

# Написи Label
Label(root, text="Ім'я:", font="Arial 12").place(x=20, y=20)
Label(root, text="Вік:", font="Arial 12").place(x=20, y=60)
Label(root, text="Про себе:", font="Arial 12").place(x=20, y=100)

# Поля Entry
entry_name = Entry(root, width=30, font="Arial 12")
entry_name.place(x=120, y=20)

entry_age = Entry(root, width=10, font="Arial 12")
entry_age.place(x=120, y=60)

# Поле Text для багаторядкового вводу
text_desc = Text(root, width=40, height=5, font="Arial 12", bg="lightcyan", wrap=WORD)
text_desc.place(x=120, y=100)

# -------------------- Checkbutton (прапорці) --------------------
Label(root, text="Хобі:", font="Arial 12").place(x=20, y=200)

cb1_var = IntVar()
cb2_var = IntVar()
cb3_var = IntVar()

Checkbutton(root, text="Спорт", variable=cb1_var).place(x=120, y=200)
Checkbutton(root, text="Музика", variable=cb2_var).place(x=220, y=200)
Checkbutton(root, text="Малювання", variable=cb3_var).place(x=320, y=200)

# -------------------- Radiobutton (перемикачі) --------------------
Label(root, text="Улюблений колір:", font="Arial 12").place(x=20, y=240)

color_var = IntVar()
Radiobutton(root, text="Червоний", variable=color_var, value=1).place(x=150, y=240)
Radiobutton(root, text="Зелений", variable=color_var, value=2).place(x=250, y=240)
Radiobutton(root, text="Синій", variable=color_var, value=3).place(x=350, y=240)

# -------------------- Кнопки --------------------
Button(root, text="Надіслати", font="Arial 12", command=submit, bg="lightgreen").place(x=120, y=280)
Button(root, text="Очистити", font="Arial 12", command=clear_all, bg="lightcoral").place(x=250, y=280)

# -------------------- Результат --------------------
result_label = Label(root, text="", font="Arial 12", bg="white", justify=LEFT, anchor="w")
result_label.place(x=20, y=330, width=560, height=150)

root.mainloop()

