from tkinter import *

# Створюємо головне вікно
root = Tk()
root.title("Малюнок іншопланетянина")
root.geometry("250x250")

# Створюємо полотно Canvas
canvas = Canvas(root, width=200, height=200, bg="lightgray")
canvas.pack(pady=10)

# Малюємо обличчя
canvas.create_oval(10, 10, 110, 110, fill="yellow", outline="black")  # обличчя
canvas.create_oval(30, 30, 50, 70, fill="black")                        # ліве око
canvas.create_oval(70, 30, 90, 70, fill="black")                        # праве око
canvas.create_rectangle(50, 110, 70, 160, fill="green")                # тулуб
canvas.create_line(50, 160, 40, 180, width=2)                           # ліва кінцівка
canvas.create_line(70, 160, 80, 180, width=2)                           # права кінцівка
canvas.create_arc(40, 70, 80, 100, start=200, extent=160, style=ARC)   # посмішка

root.mainloop()

